	               controlbar_offset="-500"
	               controlbar_offset_closed="-500"
	               design_bgalpha="0"
	               />

	<layer name="skin_layer" visible="false" />
	<layer name="skin_control_bar" visible="false" />
	<layer name="skin_splitter_bottom" visible="false" />

	<!-- Default standalone text styles -->
	<style name="Text" scale="1.0" alpha="1.0" visible="true" zorder="100" enabled="true" capture="false" />
	<style name="text" scale="1.0" alpha="1.0" visible="true" zorder="100" enabled="true" capture="false" />

	<!-- Action for dragging hotspots and standalone text labels in editor mode -->
	<action name="draghotspot">
		asyncloop(pressed,
			screentosphere(mouse.stagex, mouse.stagey, ath, atv);
		  ,
			js(onHotspotDragEnd(get(name), get(ath), get(atv)));
		  );
	</action>

